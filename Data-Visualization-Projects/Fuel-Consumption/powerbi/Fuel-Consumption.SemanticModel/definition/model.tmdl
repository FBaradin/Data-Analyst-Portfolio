model Model
	culture: es-CR
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: es-CR
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["Refuels","FilePath","QA_Checks","Refuels_Staging","_Measures"]

annotation PBI_ProTooling = ["DevMode"]

ref table Refuels
ref table Date
ref table _Measures

ref cultureInfo es-CR

